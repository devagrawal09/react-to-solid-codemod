diff --git a/crates/codemod-sandbox/examples/react_compiler_facts.rs b/crates/codemod-sandbox/examples/react_compiler_facts.rs
new file mode 100644
index 0000000..d6d4353
--- /dev/null
+++ b/crates/codemod-sandbox/examples/react_compiler_facts.rs
@@ -0,0 +1,15 @@
+//! Prints `codemod:react-compiler` results as one JSON line per file, for comparing
+//! against other analyses outside the engine.
+//!
+//! cargo run -p codemod-sandbox --example react_compiler_facts -- <FILE>...
+
+fn main() {
+    for path in std::env::args().skip(1) {
+        let source = std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("{path}: {e}"));
+        let started = std::time::Instant::now();
+        let mut facts = codemod_sandbox::react_compiler::analyze(&source, &path);
+        facts["file"] = path.into();
+        facts["us"] = (started.elapsed().as_micros() as u64).into();
+        println!("{facts}");
+    }
+}
