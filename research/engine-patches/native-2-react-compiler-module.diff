diff --git a/crates/codemod-sandbox/src/react_compiler/mod.rs b/crates/codemod-sandbox/src/react_compiler/mod.rs
new file mode 100644
index 0000000..db754b2
--- /dev/null
+++ b/crates/codemod-sandbox/src/react_compiler/mod.rs
@@ -0,0 +1,178 @@
+//! `codemod:react-compiler`: the React Compiler's analysis of a source file, from oxc's
+//! Rust port. Nothing is rewritten; codemods read which functions compile, their reactive
+//! scopes and dependencies, and which values the compiler infers to be reactive.
+//!
+//! Positions are Babel-style `"line:column"` keys (1-based line, 0-based UTF-16 column)
+//! so results join with ast-grep or Babel nodes by location.
+
+use oxc::allocator::Allocator;
+use oxc::parser::Parser;
+use oxc::semantic::SemanticBuilder;
+use oxc::span::{SourceType, Span};
+use oxc_react_compiler::{FunctionFacts, FunctionStatus, LintDiagnostic, PluginOptions};
+use rquickjs::module::{Declarations, Exports, ModuleDef};
+use rquickjs::{prelude::Opt, Ctx, Exception, Function, Object, Result, Value};
+use serde_json::{json, Value as Json};
+
+pub struct ReactCompilerModule;
+
+impl ModuleDef for ReactCompilerModule {
+    fn declare(declare: &Declarations) -> Result<()> {
+        declare.declare("analyze")?;
+        declare.declare("default")?;
+        Ok(())
+    }
+
+    fn evaluate<'js>(ctx: &Ctx<'js>, exports: &Exports<'js>) -> Result<()> {
+        let analyze = Function::new(ctx.clone(), analyze_rjs)?;
+        let default = Object::new(ctx.clone())?;
+        default.set("analyze", analyze.clone())?;
+        exports.export("analyze", analyze)?;
+        exports.export("default", default)?;
+        Ok(())
+    }
+}
+
+fn analyze_rjs<'js>(ctx: Ctx<'js>, source: String, filename: Opt<String>) -> Result<Value<'js>> {
+    let filename = filename.0.unwrap_or_else(|| "input.tsx".to_string());
+    let result = analyze(&source, &filename).to_string();
+    ctx.json_parse(result)
+        .map_err(|e| Exception::throw_message(&ctx, &format!("react-compiler: {e}")))
+}
+
+/// Analyses `source` and returns the JSON the module hands to JavaScript.
+pub fn analyze(source: &str, filename: &str) -> Json {
+    let source_type = SourceType::from_path(filename).unwrap_or_else(|_| SourceType::tsx());
+    let allocator = Allocator::default();
+    let parsed = Parser::new(&allocator, source, source_type).parse();
+    let lines = LineIndex::new(source);
+    if let Some(error) = parsed.diagnostics.first() {
+        return json!({ "parseError": error.message.to_string(), "functions": [], "diagnostics": [] });
+    }
+    let semantic = SemanticBuilder::new()
+        .with_build_nodes(true)
+        .build(&parsed.program)
+        .semantic;
+    let options = PluginOptions {
+        panic_threshold: oxc_react_compiler::PanicThreshold::None,
+        ..PluginOptions::default()
+    };
+    let (functions, diagnostics) =
+        oxc_react_compiler::facts(&parsed.program, &semantic, &allocator, options);
+    json!({
+        "parseError": null,
+        "functions": functions.iter().map(|f| function_json(f, &lines)).collect::<Vec<_>>(),
+        "diagnostics": diagnostics.iter().map(|d| json!({ "reason": d.message.to_string() })).collect::<Vec<_>>(),
+    })
+}
+
+fn function_json(f: &FunctionFacts, lines: &LineIndex) -> Json {
+    let status = match f.status {
+        FunctionStatus::Compiled => "compiled",
+        FunctionStatus::Bailout => "bailout",
+        FunctionStatus::Skipped => "skipped",
+    };
+    let reactive = f.reactive.as_ref().map(|r| {
+        json!({
+            "identifiers": r.identifiers.iter().map(|i| json!({
+                "id": i.declaration_id, "name": i.name, "loc": i.span.map(|s| lines.key(s)), "scope": i.scope,
+            })).collect::<Vec<_>>(),
+            "edges": r.edges,
+            "named": r.named.iter().map(|n| json!({
+                "loc": lines.key(n.span), "id": n.declaration_id, "name": n.name, "reactive": n.reactive,
+                "isParam": n.is_param, "ownScope": n.own_scope, "enclosingScope": n.enclosing_scope,
+                "operandIds": n.operand_ids,
+            })).collect::<Vec<_>>(),
+            "scopes": r.scopes.iter().map(|s| json!({
+                "id": s.id, "line": s.span.map(|sp| lines.line_col(sp.start).0),
+                "dependencies": s.dependencies.iter().map(|d| json!({
+                    "id": d.declaration_id, "name": d.name, "reactive": d.reactive,
+                    "path": d.path.iter().map(|(property, optional)| json!({ "property": property, "optional": optional })).collect::<Vec<_>>(),
+                })).collect::<Vec<_>>(),
+                "declarations": s.declarations, "merged": s.merged,
+            })).collect::<Vec<_>>(),
+            "returns": r.returns.iter().map(|ret| json!({ "loc": lines.key(ret.span), "id": ret.declaration_id, "reactive": ret.reactive })).collect::<Vec<_>>(),
+            "reactiveIds": r.reactive_ids,
+        })
+    });
+    json!({
+        "loc": lines.key(f.span),
+        "status": status,
+        "memoSlots": f.memo_slots,
+        "diagnostics": f.diagnostics.iter().map(|d| diagnostic_json(d, lines)).collect::<Vec<_>>(),
+        "reactive": reactive,
+    })
+}
+
+fn diagnostic_json(d: &LintDiagnostic, lines: &LineIndex) -> Json {
+    let line = d
+        .diagnostic
+        .labels
+        .first()
+        .map(|l| lines.line_col(l.offset() as u32).0);
+    json!({ "category": format!("{:?}", d.category), "reason": d.diagnostic.message.to_string(), "line": line })
+}
+
+/// Byte offsets to Babel positions.
+struct LineIndex<'s> {
+    source: &'s str,
+    starts: Vec<u32>,
+}
+
+impl<'s> LineIndex<'s> {
+    fn new(source: &'s str) -> Self {
+        let mut starts = vec![0];
+        starts.extend(source.match_indices('\n').map(|(i, _)| i as u32 + 1));
+        Self { source, starts }
+    }
+
+    fn line_col(&self, offset: u32) -> (usize, usize) {
+        let line = self.starts.partition_point(|&s| s <= offset) - 1;
+        let start = self.starts[line] as usize;
+        let end = (offset as usize).min(self.source.len());
+        let column = self
+            .source
+            .get(start..end)
+            .map_or(0, |s| s.encode_utf16().count());
+        (line + 1, column)
+    }
+
+    fn key(&self, span: Span) -> String {
+        let (line, column) = self.line_col(span.start);
+        format!("{line}:{column}")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::analyze;
+
+    #[test]
+    fn positions_use_babel_lines_and_utf16_columns() {
+        let source = "function Label(props) {\n  const ünïcode = \"é\", text = props.a + props.b;\n  return <span title={props.t}>{text}</span>;\n}\n";
+        let facts = analyze(source, "label.tsx");
+        let named = facts["functions"][0]["reactive"]["named"]
+            .as_array()
+            .unwrap();
+        let text = named.iter().find(|n| n["name"] == "text").unwrap();
+        assert_eq!(text["loc"], "2:23");
+    }
+
+    #[test]
+    fn a_component_that_mutates_props_bails_out_with_the_line_of_the_mutation() {
+        let source = "function Counter(props) {\n  props.count = 1;\n  return <span>{props.count}</span>;\n}\n";
+        let function = &analyze(source, "counter.tsx")["functions"][0];
+        assert_eq!(
+            (&function["status"], &function["diagnostics"][0]["line"]),
+            (&"bailout".into(), &2.into())
+        );
+    }
+
+    #[test]
+    fn a_file_that_does_not_parse_reports_the_parse_error_and_no_functions() {
+        let facts = analyze("function Broken( {", "broken.tsx");
+        assert!(
+            facts["parseError"].is_string() && facts["functions"].as_array().unwrap().is_empty()
+        );
+    }
+}
