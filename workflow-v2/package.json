{
  "name": "react-to-solid-workflow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build/build.mjs",
    "test": "vitest run",
    "test:slow": "vitest run --tags-filter=slow",
    "test:corpus": "node --test tests/corpus.test.mjs",
    "corpus:update-baseline": "node tests/corpus.test.mjs --update-baseline",
    "test:release": "pnpm test && pnpm test:corpus"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.40.0",
    "@babel/core": "^7.28.0",
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/plugin-syntax-jsx": "^7.27.0",
    "@babel/preset-typescript": "^7.27.0",
    "@solidjs/web": "2.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.25.11",
    "jsdom": "27.2.0",
    "path-browserify": "1.0.1",
    "rolldown": "1.3.3",
    "solid-js": "2.0.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
