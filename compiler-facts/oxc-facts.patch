+//! `facts` reports the compiler's analysis per function without rewriting anything.
+
+use oxc_allocator::Allocator;
+use oxc_parser::Parser;
+use oxc_react_compiler::{FunctionFacts, FunctionStatus, PluginOptions, facts};
+use oxc_semantic::SemanticBuilder;
+use oxc_span::SourceType;
+
+fn facts_of(source: &str) -> Vec<FunctionFacts> {
+    let allocator = Allocator::default();
+    let program = Parser::new(&allocator, source, SourceType::tsx()).parse().program;
+    let semantic = SemanticBuilder::new().with_build_nodes(true).build(&program).semantic;
+    facts(&program, &semantic, &allocator, PluginOptions::default()).0
+}
+
+const MEMOIZABLE: &str = "function Label(props) {\n  const text = props.prefix + props.text;\n  return <span title={props.title}>{text}</span>;\n}\n";
+
+#[test]
+fn a_compiled_component_reports_its_scope_dependencies_by_property_path() {
+    let reactive = facts_of(MEMOIZABLE).remove(0).reactive.unwrap();
+    let mut deps: Vec<String> = reactive
+        .scopes
+        .iter()
+        .flat_map(|scope| &scope.dependencies)
+        .map(|dep| {
+            let mut parts = vec![dep.name.as_deref().unwrap_or("?")];
+            parts.extend(dep.path.iter().map(|(property, _)| property.as_str()));
+            parts.join(".")
+        })
+        .collect();
+    deps.sort();
+    deps.dedup();
+    assert_eq!(deps, ["props.title", "text"]);
+}
+
+#[test]
+fn a_value_derived_from_props_is_reported_reactive() {
+    let reactive = facts_of(MEMOIZABLE).remove(0).reactive.unwrap();
+    let text = reactive.named.iter().find(|named| named.name.as_deref() == Some("text")).unwrap();
+    assert!(text.reactive);
+}
+
+#[test]
+fn a_component_that_breaks_the_rules_of_react_bails_out_without_reactive_facts() {
+    let source = "function Counter(props) {\n  props.count = 1;\n  return <span>{props.count}</span>;\n}\n";
+    let function = facts_of(source).remove(0);
+    assert_eq!((function.status, function.reactive.is_some()), (FunctionStatus::Bailout, false));
+}
+
+#[test]
+fn analysing_leaves_the_program_text_unchanged() {
+    let allocator = Allocator::default();
+    let program = Parser::new(&allocator, MEMOIZABLE, SourceType::tsx()).parse().program;
+    let semantic = SemanticBuilder::new().with_build_nodes(true).build(&program).semantic;
+    facts(&program, &semantic, &allocator, PluginOptions::default());
+    let printed = oxc_codegen::Codegen::new().build(&program).code;
+    assert!(!printed.contains("_c("));
+}
+
+#[test]
+fn a_destructured_default_is_reported_under_its_variable_not_the_compilers_temporary() {
+    let source = "function Slot(props) {\n  const { radius = 0 } = props;\n  return <div style={{ borderRadius: radius }} />;\n}\n";
+    let reactive = facts_of(source).remove(0).reactive.unwrap();
+    let at_radius: Vec<_> = reactive
+        .identifiers
+        .iter()
+        .filter(|i| i.span.is_some_and(|span| span.start == 33))
+        .filter_map(|i| i.name.as_deref())
+        .collect();
+    assert_eq!(at_radius, ["radius"]);
+}
