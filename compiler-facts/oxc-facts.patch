+++ b/crates/oxc_react_compiler/src/facts.rs
@@ -0,0 +1,374 @@
+//! Per-function analysis facts read from the reactive function after
+//! `PruneHoistedContexts`, for tools that want the compiler's view of a
+//! component (scopes, dependencies, reactivity) rather than its output.
+//!
+//! Identifiers are keyed by `DeclarationId`, because SSA versions of one
+//! variable joined by a phi share it. Spans are byte offsets into the source.
+
+use oxc_span::Span;
+use rustc_hash::{FxHashMap, FxHashSet};
+
+use crate::diagnostics::LintDiagnostic;
+use crate::react_compiler_hir::environment::Environment;
+use crate::react_compiler_hir::reactive::{
+    ReactiveBlock, ReactiveFunction, ReactiveInstruction, ReactiveStatement, ReactiveTerminal,
+    ReactiveValue,
+};
+use crate::react_compiler_hir::visitors::{each_instruction_value_operand, each_pattern_operand};
+use crate::react_compiler_hir::{IdentifierName, InstructionValue, ParamPattern, Place};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FunctionStatus {
+    Compiled,
+    /// The compiler gave up on this function; see `FunctionFacts::diagnostics`.
+    Bailout,
+    /// Lowering declined the function without a diagnostic, or a directive opted it out.
+    Skipped,
+}
+
+#[derive(Debug)]
+pub struct FunctionFacts {
+    pub span: Span,
+    pub status: FunctionStatus,
+    pub memo_slots: u32,
+    pub diagnostics: Vec<LintDiagnostic>,
+    /// Present when the pipeline reached `PruneHoistedContexts`.
+    pub reactive: Option<ReactiveFacts>,
+}
+
+#[derive(Debug, Default)]
+pub struct ReactiveFacts {
+    pub identifiers: Vec<IdentifierFact>,
+    /// Value flow: each declaration and the declarations it was computed from.
+    pub edges: Vec<(u32, Vec<u32>)>,
+    /// Store targets (locals, context, destructured names) and params, first occurrence per span.
+    pub named: Vec<NamedFact>,
+    pub scopes: Vec<ScopeFact>,
+    pub returns: Vec<ReturnFact>,
+    /// Declarations written by at least one reactive store.
+    pub reactive_ids: Vec<u32>,
+}
+
+#[derive(Debug, Clone)]
+pub struct IdentifierFact {
+    pub declaration_id: u32,
+    pub name: Option<String>,
+    pub span: Option<Span>,
+    pub scope: Option<u32>,
+}
+
+#[derive(Debug, Clone)]
+pub struct NamedFact {
+    pub span: Span,
+    pub declaration_id: u32,
+    pub name: Option<String>,
+    pub reactive: bool,
+    pub is_param: bool,
+    pub own_scope: Option<u32>,
+    pub enclosing_scope: Option<u32>,
+    pub operand_ids: Vec<u32>,
+}
+
+#[derive(Debug, Clone)]
+pub struct ScopeFact {
+    pub id: u32,
+    pub span: Option<Span>,
+    pub dependencies: Vec<DependencyFact>,
+    pub declarations: Vec<u32>,
+    pub merged: Vec<u32>,
+}
+
+#[derive(Debug, Clone)]
+pub struct DependencyFact {
+    pub declaration_id: u32,
+    pub name: Option<String>,
+    pub path: Vec<(String, bool)>,
+    pub reactive: bool,
+}
+
+#[derive(Debug, Clone)]
+pub struct ReturnFact {
+    pub span: Span,
+    pub declaration_id: u32,
+    pub reactive: bool,
+}
+
+/// Declarations of temporaries the compiler promoted to names, read before
+/// `rename_variables` gives them ordinary names like `t0`.
+pub(crate) fn promoted_declarations(env: &Environment<'_>) -> FxHashSet<u32> {
+    env.identifiers
+        .iter()
+        .filter(|i| matches!(i.name, Some(IdentifierName::Promoted(_))))
+        .map(|i| i.declaration_id.index() as u32)
+        .collect()
+}
+
+pub(crate) fn collect(
+    func: &ReactiveFunction<'_>,
+    env: &Environment<'_>,
+    promoted: &FxHashSet<u32>,
+) -> ReactiveFacts {
+    let mut c = Collector { env, promoted, facts: ReactiveFacts::default(), identifiers: FxHashMap::default(), edges: FxHashMap::default(), named_spans: FxHashMap::default(), reactive: Vec::new() };
+    c.visit_block(&func.body, None);
+    for param in &func.params {
+        let place = match param {
+            ParamPattern::Place(place) => place,
+            ParamPattern::Spread(spread) => &spread.place,
+        };
+        let id = c.note(place);
+        if let Some(span) = c.source_span(place) {
+            if !c.named_spans.contains_key(&span.start) {
+                c.named_spans.insert(span.start, c.facts.named.len());
+                c.facts.named.push(NamedFact { span, declaration_id: id, name: c.name_of(place), reactive: place.reactive, is_param: true, own_scope: None, enclosing_scope: None, operand_ids: Vec::new() });
+            }
+        }
+    }
+    c.finish()
+}
+
+struct Collector<'e, 'a> {
+    env: &'e Environment<'a>,
+    promoted: &'e FxHashSet<u32>,
+    facts: ReactiveFacts,
+    identifiers: FxHashMap<u32, usize>,
+    edges: FxHashMap<u32, Vec<u32>>,
+    named_spans: FxHashMap<u32, usize>,
+    reactive: Vec<u32>,
+}
+
+impl Collector<'_, '_> {
+    fn did(&self, place: &Place) -> u32 {
+        self.env.identifiers[place.identifier].declaration_id.index() as u32
+    }
+
+    /// Where a source variable is declared. Temporaries the compiler promoted to names
+    /// (`t0`) inherit the span of the pattern they came from, so they get none, or they
+    /// would be mistaken for the variable declared at the same position.
+    fn source_span(&self, place: &Place) -> Option<Span> {
+        let ident = &self.env.identifiers[place.identifier];
+        if self.promoted.contains(&(ident.declaration_id.index() as u32)) { None } else { ident.span }
+    }
+
+    fn name_of(&self, place: &Place) -> Option<String> {
+        self.env.identifiers[place.identifier].name.map(|n| n.value().to_string())
+    }
+
+    /// Records the identifier behind `place` (last write wins, as the TS consumer does).
+    fn note(&mut self, place: &Place) -> u32 {
+        let ident = &self.env.identifiers[place.identifier];
+        let id = ident.declaration_id.index() as u32;
+        let fact = IdentifierFact {
+            declaration_id: id,
+            name: ident.name.map(|n| n.value().to_string()),
+            span: self.source_span(place),
+            scope: ident.scope.map(|s| s.index() as u32),
+        };
+        match self.identifiers.get(&id) {
+            Some(&i) => self.facts.identifiers[i] = fact,
+            None => {
+                self.identifiers.insert(id, self.facts.identifiers.len());
+                self.facts.identifiers.push(fact);
+            }
+        }
+        id
+    }
+
+    fn add_edge(&mut self, from: u32, to: u32) {
+        if from == to {
+            return;
+        }
+        let tos = self.edges.entry(from).or_default();
+        if !tos.contains(&to) {
+            tos.push(to);
+        }
+    }
+
+    fn visit_block(&mut self, block: &ReactiveBlock<'_>, scope: Option<u32>) {
+        for stmt in block {
+            match stmt {
+                ReactiveStatement::Instruction(instr) => self.visit_instruction(instr, scope),
+                ReactiveStatement::Scope(block) => {
+                    let s = &self.env.scopes[block.scope];
+                    let id = block.scope.index() as u32;
+                    let dependencies = s
+                        .dependencies
+                        .iter()
+                        .map(|d| {
+                            let ident = &self.env.identifiers[d.identifier];
+                            DependencyFact {
+                                declaration_id: ident.declaration_id.index() as u32,
+                                name: ident.name.map(|n| n.value().to_string()),
+                                path: d.path.iter().map(|p| (p.property.to_string(), p.optional)).collect(),
+                                reactive: d.reactive,
+                            }
+                        })
+                        .collect();
+                    let declarations = s
+                        .declarations
+                        .iter()
+                        .map(|(_, d)| self.env.identifiers[d.identifier].declaration_id.index() as u32)
+                        .collect();
+                    let merged = s.merged.iter().map(|m| m.index() as u32).collect();
+                    self.facts.scopes.push(ScopeFact { id, span: s.span, dependencies, declarations, merged });
+                    for (_, d) in &s.declarations {
+                        let ident = &self.env.identifiers[d.identifier];
+                        let did = ident.declaration_id.index() as u32;
+                        if !self.identifiers.contains_key(&did) {
+                            self.identifiers.insert(did, self.facts.identifiers.len());
+                            self.facts.identifiers.push(IdentifierFact { declaration_id: did, name: ident.name.map(|n| n.value().to_string()), span: if self.promoted.contains(&did) { None } else { ident.span }, scope: ident.scope.map(|s| s.index() as u32) });
+                        }
+                    }
+                    self.visit_block(&block.instructions, Some(id));
+                }
+                ReactiveStatement::PrunedScope(block) => self.visit_block(&block.instructions, scope),
+                ReactiveStatement::Terminal(term) => self.visit_terminal(&term.terminal, term.span, scope),
+            }
+        }
+    }
+
+    fn visit_instruction(&mut self, instr: &ReactiveInstruction<'_>, scope: Option<u32>) {
+        let mut operands = Vec::new();
+        self.collect_operands(&instr.value, &mut operands, scope);
+        let targets: Vec<Place> = match &instr.value {
+            ReactiveValue::Instruction(value) => store_targets(value),
+            _ => Vec::new(),
+        };
+        let target_ids: Vec<u32> = targets.iter().map(|t| self.did(t)).collect();
+        let operands: Vec<Place> = operands.into_iter().filter(|o| !target_ids.contains(&self.did(o))).collect();
+        let lvalues: Vec<Place> = targets.iter().copied().chain(instr.lvalue).collect();
+        let operand_ids: Vec<u32> = operands.iter().map(|o| self.note(o)).collect();
+        for l in &lvalues {
+            let lid = self.note(l);
+            for &o in &operand_ids {
+                self.add_edge(lid, o);
+            }
+            if l.reactive && !self.reactive.contains(&lid) {
+                self.reactive.push(lid);
+            }
+        }
+        for t in &targets {
+            let ident = &self.env.identifiers[t.identifier];
+            let Some(span) = self.source_span(t) else { continue };
+            if self.named_spans.contains_key(&span.start) {
+                continue;
+            }
+            self.named_spans.insert(span.start, self.facts.named.len());
+            self.facts.named.push(NamedFact {
+                span,
+                declaration_id: ident.declaration_id.index() as u32,
+                name: ident.name.map(|n| n.value().to_string()),
+                reactive: t.reactive,
+                is_param: false,
+                own_scope: ident.scope.map(|s| s.index() as u32),
+                enclosing_scope: scope,
+                operand_ids: operand_ids.clone(),
+            });
+        }
+    }
+
+    /// Operands of a value, recursing through compound values; instructions nested in
+    /// sequence expressions are visited as instructions and contribute their lvalue.
+    fn collect_operands(&mut self, value: &ReactiveValue<'_>, out: &mut Vec<Place>, scope: Option<u32>) {
+        match value {
+            ReactiveValue::Instruction(v) => out.extend(each_instruction_value_operand(v, self.env)),
+            ReactiveValue::LogicalExpression { left, right, .. } => {
+                self.collect_operands(left, out, scope);
+                self.collect_operands(right, out, scope);
+            }
+            ReactiveValue::ConditionalExpression { test, consequent, alternate } => {
+                self.collect_operands(test, out, scope);
+                self.collect_operands(consequent, out, scope);
+                self.collect_operands(alternate, out, scope);
+            }
+            ReactiveValue::SequenceExpression { instructions, value, .. } => {
+                for inner in instructions {
+                    match inner.lvalue {
+                        Some(lvalue) => {
+                            self.visit_instruction(inner, scope);
+                            out.push(lvalue);
+                        }
+                        None => self.collect_operands(&inner.value, out, scope),
+                    }
+                }
+                self.collect_operands(value, out, scope);
+            }
+            ReactiveValue::OptionalExpression { value, .. } => self.collect_operands(value, out, scope),
+        }
+    }
+
+    /// Terminals contribute their nested blocks, instructions nested in their values, and returns.
+    fn visit_terminal_value(&mut self, value: &ReactiveValue<'_>, scope: Option<u32>) {
+        let mut ignored = Vec::new();
+        self.collect_operands(value, &mut ignored, scope);
+    }
+
+    fn visit_terminal(&mut self, term: &ReactiveTerminal<'_>, span: Span, scope: Option<u32>) {
+        match term {
+            ReactiveTerminal::Return { value, .. } => {
+                let id = self.note(value);
+                self.facts.returns.push(ReturnFact { span, declaration_id: id, reactive: value.reactive });
+            }
+            ReactiveTerminal::Break { .. } | ReactiveTerminal::Continue { .. } | ReactiveTerminal::Throw { .. } => {}
+            ReactiveTerminal::Switch { cases, .. } => {
+                for case in cases {
+                    if let Some(block) = &case.block {
+                        self.visit_block(block, scope);
+                    }
+                }
+            }
+            ReactiveTerminal::DoWhile { loop_block, test, .. } | ReactiveTerminal::While { test, loop_block, .. } => {
+                self.visit_block(loop_block, scope);
+                self.visit_terminal_value(test, scope);
+            }
+            ReactiveTerminal::For { init, test, update, loop_block, .. } => {
+                self.visit_terminal_value(init, scope);
+                self.visit_terminal_value(test, scope);
+                if let Some(update) = update {
+                    self.visit_terminal_value(update, scope);
+                }
+                self.visit_block(loop_block, scope);
+            }
+            ReactiveTerminal::ForOf { init, test, loop_block, .. } => {
+                self.visit_terminal_value(init, scope);
+                self.visit_terminal_value(test, scope);
+                self.visit_block(loop_block, scope);
+            }
+            ReactiveTerminal::ForIn { init, loop_block, .. } => {
+                self.visit_terminal_value(init, scope);
+                self.visit_block(loop_block, scope);
+            }
+            ReactiveTerminal::If { consequent, alternate, .. } => {
+                self.visit_block(consequent, scope);
+                if let Some(alternate) = alternate {
+                    self.visit_block(alternate, scope);
+                }
+            }
+            ReactiveTerminal::Label { block, .. } => self.visit_block(block, scope),
+            ReactiveTerminal::Try { block, handler, .. } => {
+                self.visit_block(block, scope);
+                self.visit_block(handler, scope);
+            }
+        }
+    }
+
+    fn finish(mut self) -> ReactiveFacts {
+        let mut edges: Vec<(u32, Vec<u32>)> = self.edges.into_iter().collect();
+        edges.sort_unstable_by_key(|(from, _)| *from);
+        self.facts.edges = edges;
+        self.facts.reactive_ids = self.reactive;
+        self.facts
+    }
+}
+
+/// Places a store writes, matching the TS consumer: locals, context variables and
+/// destructuring targets, but not update expressions.
+fn store_targets(value: &InstructionValue<'_>) -> Vec<Place> {
+    match value {
+        InstructionValue::StoreLocal { lvalue, .. }
+        | InstructionValue::StoreContext { lvalue, .. }
+        | InstructionValue::DeclareLocal { lvalue, .. }
+        | InstructionValue::DeclareContext { lvalue, .. } => vec![lvalue.place],
+        InstructionValue::Destructure { lvalue, .. } => each_pattern_operand(&lvalue.pattern).into_vec(),
+        _ => Vec::new(),
+    }
+}
