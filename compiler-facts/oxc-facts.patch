+fn record_facts<'a>(
+    source: &CompileSource<'_, 'a>,
+    compile_result: &Result<Option<CodegenFunction<'a>>, Diagnostics>,
+    opted_out: bool,
+    context: &mut ProgramContext<'a>,
+) {
+    use crate::facts::{FunctionFacts, FunctionStatus};
+    let reactive = context.pending_reactive_facts.take();
+    let span = Span::new(source.fn_start.unwrap_or(0), source.fn_end.unwrap_or(0));
+    let (status, memo_slots, diagnostics) = match compile_result {
+        Err(err) => (
+            FunctionStatus::Bailout,
+            0,
+            err.iter().cloned().map(diagnostics::categorize).collect(),
+        ),
+        Ok(None) => (FunctionStatus::Skipped, 0, Vec::new()),
+        Ok(Some(_)) if opted_out => (FunctionStatus::Skipped, 0, Vec::new()),
+        Ok(Some(codegen_fn)) => (FunctionStatus::Compiled, codegen_fn.memo_slots_used, Vec::new()),
+    };
+    let reactive = if status == FunctionStatus::Compiled { reactive } else { None };
+    if let Some(facts) = context.facts.as_mut() {
+        facts.push(FunctionFacts { span, status, memo_slots, diagnostics, reactive });
+    }
+}
